

    <!-- ================= NAVBAR ================= -->

    <header class="navbar">
        <div class="nav-container">

            <a href="#home" class="logo">
                <%= portfolioData.name %>
            </a>

            <nav>
                <a href="#home">Home</a>
                <a href="#about">About</a>
                <a href="#education">Education</a>
                <a href="#skills">Skills</a>
                <a href="#projects">Projects</a>
                <a href="#contact">Contact</a>
            </nav>

        </div>
    </header>


    <!-- ================= HERO ================= -->

    <main>

        <section id="home" class="hero">

            <div class="hero-container">

                <div class="hero-text">

                    <p class="welcome">
                        WELCOME TO MY PORTFOLIO
                    </p>

                    <h1>
                        Hello, I'm
                        <span><%= portfolioData.name %></span>
                    </h1>

                    <h2>
                        <%= portfolioData.role %>
                    </h2>

                    <p class="hero-description">
                        <%= portfolioData.about %>
                    </p>

                    <div class="hero-buttons">

                        <a href="#about" class="btn primary">
                            Explore My Profile
                        </a>

                        <a href="#contact" class="btn secondary">
                            Contact Me
                        </a>

                    </div>

                </div>


                <div class="profile-area">

                    <div class="profile-circle">
                        <div class="profile-placeholder">
                            <span>PROFILE</span>
                        </div>
                    </div>

                </div>

            </div>

        </section>


        <!-- ================= ABOUT ================= -->

        <section id="about" class="section">

            <div class="section-title">

                <span>01</span>

                <div>
                    <p>GET TO KNOW ME</p>
                    <h2>About Me</h2>
                </div>

            </div>


            <div class="about-grid">

                <div class="about-text">

                    <h3>
                        Passionate about learning,
                        creating and improving.
                    </h3>

                    <p>
                        <%= portfolioData.about %>
                    </p>

                    <p>
                        I am continuously developing my technical
                        knowledge and working on practical projects
                        to improve my problem-solving and development
                        skills.
                    </p>

                </div>


                <div class="information-card">

                    <h3>Personal Information</h3>

                    <div class="info-row">
                        <span>Date of Birth</span>
                        <strong><%= portfolioData.dob %></strong>
                    </div>

                    <div class="info-row">
                        <span>Address</span>
                        <strong><%= portfolioData.address %></strong>
                    </div>

                    <div class="info-row">
                        <span>Phone</span>
                        <strong><%= portfolioData.phone %></strong>
                    </div>

                    <div class="info-row">
                        <span>Email</span>
                        <strong><%= portfolioData.email %></strong>
                    </div>

                </div>

            </div>

        </section>


        <!-- ================= EDUCATION ================= -->

        <section id="education" class="section light-section">

            <div class="section-title">

                <span>02</span>

                <div>
                    <p>MY ACADEMIC JOURNEY</p>
                    <h2>Education</h2>
                </div>

            </div>


            <div class="timeline">

                <% if (portfolioData.education) { %>

                    <% portfolioData.education.forEach((item, index) => { %>

                        <div class="timeline-item">

                            <div class="timeline-number">
                                0<%= index + 1 %>
                            </div>

                            <div class="timeline-content">

                                <span>
                                    <%= item.year %>
                                </span>

                                <h3>
                                    <%= item.degree %>
                                </h3>

                                <p>
                                    <%= item.institute %>
                                </p>

                            </div>

                        </div>

                    <% }) %>

                <% } %>

            </div>

        </section>


        <!-- ================= SKILLS ================= -->

        <section id="skills" class="section">

            <div class="section-title">

                <span>03</span>

                <div>
                    <p>WHAT I WORK WITH</p>
                    <h2>Skills</h2>
                </div>

            </div>


            <div class="skills-container">

                <% if (portfolioData.skills) { %>

                    <% portfolioData.skills.forEach((skill) => { %>

                        <div class="skill">

                            <div class="skill-icon">
                                &lt;/&gt;
                            </div>

                            <h3>
                                <%= skill %>
                            </h3>

                        </div>

                    <% }) %>

                <% } %>

            </div>

        </section>


        <!-- ================= PROJECTS ================= -->

        <section id="projects" class="section light-section">

            <div class="section-title">

                <span>04</span>

                <div>
                    <p>MY RECENT WORK</p>
                    <h2>Projects</h2>
                </div>

            </div>


            <div class="projects">

                <% if (portfolioData.projects) { %>

                    <% portfolioData.projects.forEach((project, index) => { %>

                        <article class="project-card">

                            <div class="project-top">

                                <span class="project-number">
                                    0<%= index + 1 %>
                                </span>

                                <span class="project-arrow">
                                    ↗
                                </span>

                            </div>

                            <h3>
                                <%= project.title %>
                            </h3>

                            <p>
                                <%= project.description %>
                            </p>


                            <div class="project-tech">

                                <% project.technologies.forEach(tech => { %>

                                    <span>
                                        <%= tech %>
                                    </span>

                                <% }) %>

                            </div>


                            <% if (project.link) { %>

                                <a
                                    href="<%= project.link %>"
                                    target="_blank"
                                    class="project-link"
                                >
                                    View Project →
                                </a>

                            <% } %>

                        </article>

                    <% }) %>

                <% } %>

            </div>

        </section>


        <!-- ================= EXPERIENCE ================= -->

        <section class="section">

            <div class="section-title">

                <span>05</span>

                <div>
                    <p>MY PROFESSIONAL JOURNEY</p>
                    <h2>Experience</h2>
                </div>

            </div>


            <div class="experience-box">

                <% if (portfolioData.experience &&
                       portfolioData.experience.length > 0) { %>

                    <% portfolioData.experience.forEach(exp => { %>

                        <div class="experience-item">

                            <h3>
                                <%= exp.position %>
                            </h3>

                            <p class="company">
                                <%= exp.company %>
                            </p>

                            <span>
                                <%= exp.duration %>
                            </span>

                            <p>
                                <%= exp.description %>
                            </p>

                        </div>

                    <% }) %>

                <% } else { %>

                    <p class="empty-message">
                        Professional experience will be added soon.
                    </p>

                <% } %>

            </div>

        </section>


        <!-- ================= CONTACT ================= -->

        <section id="contact" class="contact">

            <div class="contact-container">

                <p class="contact-small">
                    HAVE A QUESTION OR OPPORTUNITY?
                </p>

                <h2>
                    Let's Connect.
                </h2>

                <p>
                    I'm always interested in learning,
                    collaborating and discussing new opportunities.
                </p>


                <a
                    href="mailto:<%= portfolioData.email %>"
                    class="contact-email"
                >
                    <%= portfolioData.email %>
                </a>


                <div class="social-links">

                    <a
                        href="<%= portfolioData.github %>"
                        target="_blank"
                    >
                        GitHub
                    </a>

                    <a
                        href="<%= portfolioData.linkedin %>"
                        target="_blank"
                    >
                        LinkedIn
                    </a>

                </div>

            </div>

        </section>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer>

        <p>
            © <%= new Date().getFullYear() %>
            <%= portfolioData.name %>
        </p>

        <span>
            Designed & Built with passion.
        </span>

    </footer>


